# Пример окружения кабинета. Скопируйте в `.env` и заполните значениями.
# Файл с настоящими значениями (`.env`) в репозиторий не попадает — см. .gitignore.

# Адрес внутреннего API бота. Роутер `/internal/*` бота работает только на
# loopback и наружу не выставлен (§3.4 спеки). Здесь стоит плейсхолдер:
# реальный хост и порт задаются в развёртывании и в публичный репозиторий
# не попадают.
BOT_BASE_URL=http://127.0.0.1:8007

# Общий секрет кабинета и бота. Передаётся в заголовке `X-Internal-Secret`.
# Имя переменной — `CABINET_INTERNAL_SECRET`: так его задаёт юнит выкладки.
# Второе имя для того же секрета разошлось бы с ним при развёртывании.
# Значение согласовано с ботом и задаётся окружением; в коде и в этом файле
# его быть не должно — здесь только пустое значение.
CABINET_INTERNAL_SECRET=

# --- Отправка почты (W2.1) -----------------------------------------------
#
# Транспорт выбирается здесь и больше нигде: код кабинета о транспорте не
# знает. Допустимо `smtp` или `api`. Переменные, которые нужны только
# выбранному транспорту, обязаны быть заполнены: неполный конфиг — отказ на
# старте, а не тихий откат на другой транспорт.

# `smtp` — SMTP с обязательным STARTTLS; `api` — HTTP-API почтового сервиса.
MAIL_TRANSPORT=smtp

# Адрес в поле «От». Общий для обоих транспортов.
MAIL_FROM=

# Таймаут одной попытки отправки, секунды. Не задан — берётся 10.
MAIL_TIMEOUT=10

# SMTP. Нужны, когда MAIL_TRANSPORT=smtp.
# Порт по умолчанию 587 — порт submission со STARTTLS.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# HTTP-API. Нужны, когда MAIL_TRANSPORT=api.
#
# Транспорт — Brevo: бесплатный тариф, отправка по HTTP, свой SMTP не нужен.
# Значения подставляются развёртыванием; ключ в публичный репозиторий не попадает.
#
# Перед включением обязательно (проверяется вручную, автотестом не выйдет):
#   1. домен отправителя верифицирован в панели Brevo — иначе письма не уйдут;
#   2. записи SPF и DKIM добавлены в DNS домена;
#   3. письмо доходит до mail.ru и yandex и НЕ попадает в спам.
# Без третьего шага вход по почте «работает», но письма не доходят.
MAIL_API_URL=
MAIL_API_KEY=

# --- Оплата (шаг 5 покупки, #61) -----------------------------------------
#
# Свой магазин ЮKassa в кабинете. Значения подставляются развёртыванием; ключ в
# публичный репозиторий не попадает.
#
# Неполный конфиг НЕ роняет запуск кабинета: вход и подписки работают и без
# оплаты. Но и не подменяется выдуманным платежом — экран оплаты честно говорит,
# что оплата недоступна, пока переменные не заданы.
#
# Чек кабинет не формирует: им занимается страница оплаты ЮKassa (спека §3а),
# поэтому адрес покупателя здесь не нужен.

# Идентификатор магазина и секретный ключ из личного кабинета ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Публичный адрес кабинета. Из него собираются два адреса возврата:
#   - после оплаты (`/buy/done?order_id=…`) — относительный ЮKassa не примет;
#   - для ссылки в сообщении бота (`/login/telegram/return`), по которой
#     человек возвращается уже вошедшим (§5.2 контракта, issue #52).
# Пусто — законное состояние локального запуска: оплата недоступна, а бот шлёт
# только код, как раньше.
CABINET_PUBLIC_BASE=

# Адрес API ЮKassa. Необязателен: по умолчанию — боевой адрес API.
# YOOKASSA_API_BASE=https://api.yookassa.ru/v3
